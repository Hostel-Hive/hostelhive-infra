# Compose reads this file automatically. Scripts use process environment variables.
# Replace these placeholders locally. Never commit the resulting .env.
POSTGRES_USER=hostelhive
POSTGRES_DB=hostelhive
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_PORT=15433
BACKEND_PORT=18080
BACKEND_SOURCE=../../HostelHive-Backend/hostelhive-backend
# Percent-encode special characters in the password in this URL.
BACKEND_DATABASE_URL=postgres://hostelhive:REPLACE_WITH_LOCAL_PASSWORD@postgres:5432/hostelhive?sslmode=disable
FIREBASE_PROJECT_ID=your-firebase-project-id
# Existing credential file outside the repository, mounted read-only by Compose.
FIREBASE_CREDENTIALS_FILE=C:/private/hostelhive-service-account.json
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Hosted backend configuration reference; copy values into Render separately.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# RTDB_ENABLED=true
# FIREBASE_DATABASE_URL=https://YOUR_DATABASE.firebasedatabase.app
# R2_ENABLED=true
# R2_ACCOUNT_ID=REPLACE_ME
# R2_BUCKET=hostelhive-private-images
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
# STUDENT_INVITATIONS_ENABLED=true
# STUDENT_EMAIL_DOMAINS=gmail.com,stu.kln.ac.lk
# FCM_ENABLED=false
